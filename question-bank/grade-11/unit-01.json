      "sourceQuestionNumber": 1,
      "type": "single_choice",
      "stem": "An estimation of a physical quantity is best described as:",
      "options": [
        {
          "id": "A",
          "text": "an exact experimental result"
        },
        {
          "id": "B",
          "text": "a random numerical guess"
        },
        {
          "id": "C",
          "text": "a rough educated value based on experience and physical reasoning"
        },
        {
          "id": "D",
          "text": "a value having no physical unit"
