      "topic": "Conservative vs non-conservative field work",
      "stem": "Which statement correctly distinguishes conservative gravitational work from the work of kinetic friction?",
      "options": [
        {
          "id": "A",
          "text": "Both gravity and kinetic friction do zero work around every closed path."
        },
        {
          "id": "B",
          "text": "Gravity's work depends on the exact route, while friction's work depends only on endpoints."
        },
        {
          "id": "C",
          "text": "Gravity's work depends only on the endpoints, whereas kinetic friction generally depends on path length."
        },
        {
          "id": "D",
          "text": "Both gravity and kinetic friction always do positive work."
        }
      ]
    },
